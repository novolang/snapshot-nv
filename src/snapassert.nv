// snapassert.nv — the assertion, which answers instead of raising.
//
// THE LOAD-BEARING INTERFACE IS `SnapVerdict`.  `check` compares a
// value against the stored snapshot and ANSWERS what happened; it never
// fails a test, never prints, and never decides what a mismatch means.
// `assert_snapshot` is a nine-line wrapper over it that reports through
// `std.test`, and it is the only `[io]` function here.
//
// Every other snapshot library makes the assertion the primitive, and
// pays for it three times.
//
//   1. THE LIBRARY CANNOT BE TESTED BY THE LIBRARY.  "A mismatch under
//      `SnapNever` writes nothing" is a statement about a verdict.
//      Where the only entry point fails the test, asserting it means
//      catching a panic and reading a message.
//   2. A REVIEW TOOL NEEDS A SECOND CODE PATH.  `novo test --review`
//      wants the same comparison with a different consequence.  With a
//      verdict it is the same call.
//   3. A RUNNER CANNOT AGGREGATE.  "Eleven snapshots changed" is the
//      useful report, and it is unreachable if the first mismatch ends
//      the process.
//
// AND THE POLICY IS AN ARGUMENT, which is the other half of the same
// decision — see `snappolicy`'s module comment.  Together they make
// `check` `[fs]`: it reads a file and may write one, and it reads no
// environment and prints nothing.
//
// WHAT `novo test` WOULD HAVE TO EXPOSE, named here and filed nowhere:
//
//   · **A test's own identity.**  `std.test` gives a running test no
//     way to learn its name or its source file, so `SnapRequest` takes
//     both as text and every call site repeats them.  insta's macro
//     reads them from the compiler; the equivalent here is something
//     like `test.current_name()` and `test.current_source()`, and
//     without them a renamed test silently keeps its old snapshot.
//   · **`novo test --review`** — walk the `.new` files
//     (`snapfile.rejected_under`), show each diff, accept or reject
//     (`snapfile.accept_rejected` / `clear_rejected`).  Every part of
//     that except the terminal is in this package already.
//   · **`novo test --update-snapshots[=never|new|auto|always]`**, which
//     sets `SnapConfig.update` rather than exporting an environment
//     variable, so one run can hold two policies.
//   · **The used-name set.**  The unused-snapshot check needs every
//     name the run asked for; only the runner sees all of them.
//     `snapfile.unused_names` is the arithmetic, waiting for the list.

use snappolicy
use snapfile
use snapredact
use diffunit
use diffscript
use diffrender

// What a comparison found.
//
// Five answers, and the split that matters is between `SnapAbsent` and
// `SnapDiffered`: a snapshot that has never been recorded is a
// different thing from one that changed, the update policy treats them
// differently, and a library that reported both as "failed" would make
// a first run indistinguishable from a regression.
pub enum SnapVerdict
    // The value equals the stored snapshot.  Nothing was written, and
    // any stale `.new` beside it was removed.
    SnapMatched
    // There was no stored snapshot and the policy recorded one.  The
    // path is where it landed, so a runner can say so.
    SnapRecorded(path: Str)
    // There was no stored snapshot and the policy would not record
    // one.  A failure, and a different failure from a mismatch.
    SnapAbsent(path: Str)
    // The value differs.  `rejected` is where the `.new` file went, or
    // `""` when the policy wrote none; `diff` is the rendered unified
    // diff, already cut to the configured line ceiling.
    SnapDiffered(path: Str, rejected: Str, diff: Str)
    // Something about the file itself went wrong.
    SnapFaulted(why: snapfile.SnapError)

// Everything a check needs except the value.
//
// A value built once per test and reused for every assertion in it,
// which is also what makes several snapshots in one test cheap.
pub struct SnapRequest
    config: snappolicy.SnapConfig
    // The test's source file, as the caller spells it.  `std.test`
    // cannot tell a running test its own file; see the module comment.
    source: Str
    // The assertion's name, unique within the source file.
    assertion: Str
    // The expression the value came from, as text, for the header.
    expression: Str
    // Applied, in order, before the comparison and before the write.
    redactions: [snapredact.SnapRedaction]

// ── private helpers ──────────────────────────────────────────────────
//
// One named function per decision `check` makes, so that every arm of
// the policy reads as the sentence it is.  Private because the public
// vocabulary for all of it is the verdict.

// The actual value as the comparison sees it: the request's redactions
// applied, in order, to what the caller produced.  The one rule the
// whole package rests on, named once.
fn actual_of(r: SnapRequest, value: Str) -> Str []
    snapredact.apply_all(r.redactions, value)

// The snapshot the actual value would be written as: the request's
// header — source, assertion, expression, and the labels of the
// redactions whose work the value already carries — and the value.
fn stored_as(r: SnapRequest, actual: Str) -> snapfile.SnapStored []
    let expressed = snapfile.with_expression(snapfile.header(r.source, r.assertion),
                                             r.expression)
    let labelled = snapfile.with_redactions(expressed, snapredact.labels(r.redactions))
    SnapStored { header: labelled, value: actual }

// Write the actual value where the stored snapshot belongs, and answer
// `ok` when it landed.  A refused write is a fault and not a panic: a
// snapshot that could not be written is something a report says, and
// the verdict is where it is said.
fn store(r: SnapRequest, path: Str, actual: Str, ok: SnapVerdict) -> SnapVerdict [fs]
    match snapfile.write(path, stored_as(r, actual))
        Some(e) => SnapFaulted(e)
        None    => ok

// A missing snapshot under a policy that leaves the evidence: the value
// that would have been stored lands in the `.new` file beside the
// snapshot, so the first run of a new test leaves something a person can
// look at.  The verdict stays the absence — `SnapAbsent` carries the
// snapshot's path and has no rejected one to carry — and a write that
// could not land is the fault it is, rather than a silence.
fn absent_beside(r: SnapRequest, path: Str, actual: Str) -> SnapVerdict [fs]
    match snapfile.write_rejected(r.config, path, stored_as(r, actual))
        Ok(_)  => SnapAbsent(path)
        Err(e) => SnapFaulted(e)

// There was nothing stored: record one when the policy records missing
// snapshots, leave the value in a `.new` when the policy leaves rejected
// files, and answer the absence by name either way.  This is the split
// `SnapAbsent` exists for — a snapshot that was never recorded is not
// one that changed — and the policy decides what is written, not what
// the answer is called.
fn no_stored(r: SnapRequest, path: Str, actual: Str) -> SnapVerdict [fs]
    if snappolicy.records_when_missing(r.config.update)
        store(r, path, actual, SnapRecorded(path))
    elif snappolicy.leaves_rejected(r.config.update)
        absent_beside(r, path, actual)
    else
        SnapAbsent(path)

// The value equals the stored snapshot.  Nothing is written, and a
// stale `.new` beside it goes: a rejected file next to a passing
// snapshot makes a review tool offer a change nobody made.  A clear
// that fails is not worth failing an assertion over — the value
// matched, which is what the verdict says — so the answer is dropped.
fn matched(r: SnapRequest, path: Str) -> SnapVerdict [fs]
    let _ = snapfile.clear_rejected(r.config, path)
    SnapMatched

// A stored snapshot was read, so it either matches or the policy
// decides what a difference means.  `SnapAlways` overwrites, and the
// value is then the stored one — which is what `SnapMatched` says, the
// five answers being the whole vocabulary; the two `.new`-writing modes
// leave the evidence and differ.
fn against(r: SnapRequest, path: Str, stored: Str, actual: Str) -> SnapVerdict [fs]
    if agrees(r, stored, actual)
        matched(r, path)
    elif snappolicy.overwrites(r.config.update)
        store(r, path, actual, SnapMatched)
    else
        differed(r, path, stored, actual)

// A differing value under a policy that leaves the evidence: the
// rejected file lands, and the verdict carries where.
fn rejected_beside(r: SnapRequest, path: Str, actual: Str, diff: Str) -> SnapVerdict [fs]
    match snapfile.write_rejected(r.config, path, stored_as(r, actual))
        Ok(rejected) => SnapDiffered(path, rejected, diff)
        Err(e)       => SnapFaulted(e)

// A differing value.  The diff is rendered first, because it belongs in
// the verdict either way, and only then does the policy decide whether
// there is a file to point at.
fn differed(r: SnapRequest, path: Str, stored: Str, actual: Str) -> SnapVerdict [fs]
    let diff = render_diff(r.config, stored, actual)
    if snappolicy.leaves_rejected(r.config.update)
        rejected_beside(r, path, actual, diff)
    else
        SnapDiffered(path, "", diff)

// The stored file read: a snapshot that parses is compared, one that is
// missing is the absence case, and anything else — an assertion name
// that cannot be a filename, a header this build does not read, a file
// that cannot be read — is a fault, carrying the reason.
fn check_at(r: SnapRequest, path: Str, actual: Str) -> SnapVerdict [fs]
    match snapfile.read(path)
        Ok(stored)          => against(r, path, snapfile.value_of(stored), actual)
        Err(SnapMissing(_)) => no_stored(r, path, actual)
        Err(e)              => SnapFaulted(e)

// The message for a snapshot that was never recorded: the path, and the
// one thing that records it.  Only `SnapAuto` and `SnapAlways` write a
// missing snapshot, so the mode has to be asked for by name — and the
// name is the published one, not a spelling repeated here.
//
// The `.new` file the default policy leaves is named as a possibility
// rather than as a path, because the verdict carries the snapshot's path
// and not the rejected one.
fn absent_message(path: Str) -> Str []
    let how = "re-run with " + snappolicy.env_name() + "=auto to record it"
    let beside = "a `.new` file beside it, when the policy leaves one, holds what it would have been"
    "no snapshot at `${path}`: " + how + "\n" + beside

// The message for a differing value: the stored path, the rejected
// path, how to accept it, and then the diff — in that order, because
// the reader's first question is which file and their second is how to
// accept it.  A message that led with the diff buried both.
//
// Under `SnapNever` there is no rejected file, and the message says so
// rather than pointing at a path nothing wrote.  A verdict carrying no
// diff ends after the instruction, with no empty diff block under it.
fn differed_message(path: Str, rejected: Str, diff: Str) -> Str []
    let head = if str.is_empty(rejected)
        "the snapshot at `${path}` differs, and no rejected file was written"
    else
        "the snapshot at `${path}` differs; the new value is in `${rejected}`"
    let how = if str.is_empty(rejected)
        "re-run with the `new` or `auto` update policy to write it beside the snapshot"
    else
        "accept it with `snapfile.accept_rejected`, or delete it to keep the stored one"
    if str.is_empty(diff)
        head + "\n" + how
    else
        head + "\n" + how + "\n" + diff

// `3 recorded` — what one kind contributes to a run's summary.  The
// kinds are counted through `verdict_name`, so a summary and a
// machine-readable report can never disagree about what a verdict is
// called.
fn count_phrase(vs: [SnapVerdict], name: Str) -> Str []
    var n = 0
    for v in vs
        if verdict_name(v) == name
            n = n + 1
    str.from_int(n) + " " + name

// The five verdict names, in the order a run's summary reads them.
fn report_names() -> [Str] []
    ["matched", "recorded", "absent", "differed", "faulted"]

// The context a rendered diff carries: three lines around each hunk,
// which is `diff -U3` and what a `git diff` shows.  A configuration
// field of its own only if one ever wants a different number, the
// ceiling a reader actually changes being `max_diff_lines`.
fn diff_context() -> Int []
    3

// The rendered diff, cut to the configured ceiling with the count of
// what was cut on the end: a thousand-line difference in a test log
// buries every other failure in the run.
fn cut(c: snappolicy.SnapConfig, text: Str) -> Str []
    let lines = str.split_lines(text)
    let over = list.len(lines) - c.max_diff_lines
    if over <= 0
        text
    else
        let kept = list.join(list.take(lines, c.max_diff_lines), "\n")
        kept + "\n... " + str.from_int(over) + " more lines of diff\n"

// A request with the default configuration and no redactions.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     println(snapassert.request("tests/render_tests.nv", "a_wide_table").assertion)
// ```
pub fn request(source: Str, assertion: Str) -> SnapRequest []
    SnapRequest {
        config: snappolicy.config(),
        source: source,
        assertion: assertion,
        expression: "",
        redactions: [] }

// The request with a different configuration.
//
// ```novo
// use snappolicy
// use snapassert
//
// fn main() [io]
//     let r = snapassert.request("t.nv", "a")
//     let c = snappolicy.with_update(snappolicy.config(), SnapNever)
//     println(snappolicy.update_name(snapassert.with_config(r, c).config.update))
// ```
pub fn with_config(r: SnapRequest, c: snappolicy.SnapConfig) -> SnapRequest []
    SnapRequest {
        config: c,
        source: r.source,
        assertion: r.assertion,
        expression: r.expression,
        redactions: r.redactions }

// The request with redactions.
//
// ```novo
// use snapassert
// use snapredact
// use std.list
//
// fn main() [io]
//     let r = snapassert.request("t.nv", "a")
//     let with = snapassert.with_redactions(r, snapredact.cli_defaults())
//     println("${list.len(with.redactions)}")
// ```
pub fn with_redactions(r: SnapRequest, rs: [snapredact.SnapRedaction]) -> SnapRequest []
    SnapRequest {
        config: r.config,
        source: r.source,
        assertion: r.assertion,
        expression: r.expression,
        redactions: rs }

// The request with the expression text a reader of the file will see.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     let r = snapassert.request("t.nv", "a")
//     println(snapassert.with_expression(r, "render(t)").expression)
// ```
pub fn with_expression(r: SnapRequest, expression: Str) -> SnapRequest []
    SnapRequest {
        config: r.config,
        source: r.source,
        assertion: r.assertion,
        expression: expression,
        redactions: r.redactions }

// The request for another assertion in the same source file.
//
// The call a test with several snapshots makes, so the source file and
// the configuration are written once.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     let r = snapassert.request("t.nv", "first")
//     println(snapassert.named(r, "second").assertion)
// ```
pub fn named(r: SnapRequest, assertion: Str) -> SnapRequest []
    SnapRequest {
        config: r.config,
        source: r.source,
        assertion: assertion,
        expression: r.expression,
        redactions: r.redactions }

// Compare a value with its stored snapshot, and answer what happened.
//
// THE PRIMITIVE.  Reads the stored file, applies the redactions to the
// actual value, compares, and — according to the policy — writes the
// snapshot, writes a `.new` beside it, or writes nothing.  It fails
// nothing and prints nothing.
//
// `[fs]`: a file read, and at most one file written. No environment, no
// clock, no terminal.
//
// ```novo
// use snapassert
//
// fn main() [io, fs]
//     let r = snapassert.request("tests/render_tests.nv", "a_wide_table")
//     println(snapassert.verdict_name(snapassert.check(r, "hello\n")))
// ```
pub fn check(r: SnapRequest, value: Str) -> SnapVerdict [fs]
    match snapfile.snapshot_path(r.config, r.source, r.assertion)
        Ok(path) => check_at(r, path, actual_of(r, value))
        Err(e)   => SnapFaulted(e)

// Compare against a snapshot the caller already has in hand.
//
// `[]`, and the whole comparison rule in one place: apply the
// redactions, compare the strings.  Published because it is what makes
// every interesting case in this package's own suite a pure function —
// and because a caller with the stored value from somewhere else (a
// fixture, a database, another process) should not have to go through
// a file to use the rule.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     let r = snapassert.request("t.nv", "a")
//     let same = snapassert.agrees(r, "hello\n", "hello\n")
//     println("${same}")
// ```
pub fn agrees(r: SnapRequest, stored: Str, actual: Str) -> Bool []
    actual_of(r, actual) == stored

// A function rather than two lines inside `assert_snapshot`, so that the
// failure path is one uncovered place with one reason rather than two.
//
// cov: skip — runs only when a snapshot assertion fails, which fails the
// calling test
fn report(r: SnapRequest, v: SnapVerdict) [io]
    test.case(r.assertion)
    test.fail(message(v))

// Run a check and report it through `std.test`.
//
// The nine lines over `check` that a test writes, and the only `[io]`
// function in the module: on anything but `SnapMatched` it calls
// `test.case` with the assertion's name and `test.fail` with the
// message below.
//
// ```novo
// use snapassert
//
// fn main() [io, fs]
//     let r = snapassert.request("tests/render_tests.nv", "a_wide_table")
//     snapassert.assert_snapshot(r, "hello\n")
// ```
pub fn assert_snapshot(r: SnapRequest, value: Str) [fs, io]
    let v = check(r, value)
    if not passed(v)
        // cov: skip — the failure path of a snapshot assertion, which
        // fails the calling test
        report(r, v)

// Whether a verdict means the test passed.
//
// `SnapMatched` and `SnapRecorded` — recording a first snapshot is a
// pass, which is what makes `SnapAuto` usable while a test is being
// written.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     println("${snapassert.passed(SnapMatched)}")
// ```
pub fn passed(v: SnapVerdict) -> Bool []
    match v
        SnapMatched           => true
        SnapRecorded(_)       => true
        SnapAbsent(_)         => false
        SnapDiffered(_, _, _) => false
        SnapFaulted(_)        => false

// The verdict's short name: `matched`, `recorded`, `absent`,
// `differed`, `faulted`.
//
// For a machine-readable report, and for a runner's summary line.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     println(snapassert.verdict_name(SnapMatched))
// ```
pub fn verdict_name(v: SnapVerdict) -> Str []
    match v
        SnapMatched           => "matched"
        SnapRecorded(_)       => "recorded"
        SnapAbsent(_)         => "absent"
        SnapDiffered(_, _, _) => "differed"
        SnapFaulted(_)        => "faulted"

// The message a person reads when a snapshot fails.
//
// The stored path, the rejected path, what to run to accept it, and
// then the diff.  In that order: the reader's first question is which
// file, the second is how to accept, and the diff is what they scroll
// through.  A message that led with the diff buried both.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     println(snapassert.message(SnapAbsent("tests/snapshots/t__a.snap")))
// ```
pub fn message(v: SnapVerdict) -> Str []
    match v
        SnapMatched                        => "the snapshot matched"
        SnapRecorded(path)                 => "recorded the snapshot at `${path}`"
        SnapAbsent(path)                   => absent_message(path)
        SnapDiffered(path, rejected, diff) => differed_message(path, rejected, diff)
        SnapFaulted(why)                   => why.message()

// The rendered diff a verdict carries, or `""`.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     println(snapassert.diff_of(SnapMatched))
// ```
pub fn diff_of(v: SnapVerdict) -> Str []
    match v
        SnapDiffered(_, _, diff) => diff
        _                        => ""

// The stored snapshot's path, whatever the verdict.
//
// Every variant but `SnapFaulted` carries one, and a runner collecting
// "what changed in this run" wants the path from all of them.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     println(snapassert.path_of(SnapAbsent("tests/snapshots/t__a.snap")))
// ```
pub fn path_of(v: SnapVerdict) -> Str []
    match v
        SnapRecorded(path)       => path
        SnapAbsent(path)         => path
        SnapDiffered(path, _, _) => path
        SnapMatched              => ""
        SnapFaulted(_)           => ""

// The unified diff between the stored value and the actual one.
//
// Three calls into diff-nv and no algorithm of this package's own:
// tokenise both sides by line, walk them, render unified with the
// configured context. Cut to `config.max_diff_lines` with the count of
// what was cut on the end, because a thousand-line diff in a test log
// buries every other failure in the run.
//
// `[]`, so a review tool can render a diff it is not going to assert
// on.
//
// ```novo
// use snappolicy
// use snapassert
//
// fn main() [io]
//     println(snapassert.render_diff(snappolicy.config(), "a\n", "b\n"))
// ```
pub fn render_diff(c: snappolicy.SnapConfig, stored: Str, actual: Str) -> Str []
    let input = diffunit.tokenize(stored, actual, DiffLines)
    let script = diffscript.diff(input, diffscript.default_options())
    let options = diffrender.unified_options_named(diff_context(), "stored", "actual")
    let text = diffrender.unified(input, script, options)
    cut(c, text)

// The one-line summary of a difference: how many lines went and came.
//
// What a runner prints per changed snapshot in a list of eleven, where
// the diff itself belongs behind a flag.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     println(snapassert.diff_summary("a\nb\n", "a\nc\n"))
// ```
pub fn diff_summary(stored: Str, actual: Str) -> Str []
    let input = diffunit.tokenize(stored, actual, DiffLines)
    let script = diffscript.diff(input, diffscript.default_options())
    let counts = diffscript.counts(script)
    let went = str.from_int(counts.0) + " removed"
    let came = str.from_int(counts.1) + " added"
    went + ", " + came

// A runner's report over many verdicts: matched, recorded, absent,
// differed, faulted.
//
// The aggregation that a library which raises on the first mismatch
// cannot produce, and the reason `check` answers.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     println(snapassert.summarise([SnapMatched, SnapMatched]))
// ```
pub fn summarise(vs: [SnapVerdict]) -> Str []
    let parts = [count_phrase(vs, name) for name in report_names()]
    let total = list.len(vs)
    let plural = if total == 1
        ""
    else
        "s"
    let head = str.from_int(total) + " snapshot" + plural + ": " + list.join(parts, ", ")
    head + " (" + str.from_int(failure_count(vs)) + " failed)"

// How many of a run's verdicts were not passes.
//
// ```novo
// use snapassert
//
// fn main() [io]
//     println("${snapassert.failure_count([SnapMatched])}")
// ```
pub fn failure_count(vs: [SnapVerdict]) -> Int []
    var n = 0
    for v in vs
        if not passed(v)
            n = n + 1
    n
