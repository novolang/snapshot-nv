// snapredact.nv — the volatile fields, replaced before they are
// stored.
//
// A SNAPSHOT OF ANYTHING REAL CONTAINS SOMETHING THAT CHANGES.  A
// timestamp, a generated identifier, an absolute path with somebody's
// home directory in it, a duration in milliseconds.  Left alone, the
// snapshot fails on the second run and the suite gets deleted.
//
// THE REDACTION IS APPLIED BEFORE THE VALUE IS STORED, not when it is
// compared.  Which means the file on disk already reads
// `created: [timestamp]`, and three things follow:
//
//   1. The stored file is stable — a reader in a code review sees the
//      redaction rather than a value that is about to change.
//   2. The comparison is a plain string compare, with no rules of its
//      own, so there is exactly one place a redaction can be wrong.
//   3. A redaction ADDED to a test changes the stored file, which shows
//      up in review as a change — where a compare-time rule would
//      change what passes with no diff at all.
//
// A REDACTION IS A LABEL AND A NAMED FUNCTION.  The label goes in the
// header so a reader can tell a real `[timestamp]` in some program's
// output from one this package put there.  The function is
// `fn(Str) -> Str` in a struct field, which is matchers-nv's
// arrangement and for the same reason: SPEC § 3.6's bounds carry an
// effect argument and never a type one, so a combinator over values
// cannot be written against a trait.
//
// The functions this module ships are named functions, not lambdas, so
// that the ones a caller writes look like the ones here.  A `@value`
// struct could not hold one of these fields at all, which is why
// `SnapRedaction` is an ordinary struct.

// One replacement applied to a snapshot value before it is stored.
pub struct SnapRedaction
    // What the header records.  Short, lower-case, and the same word
    // the constructor is named after.
    label: Str
    // The replacement itself: the whole value in, the whole value out.
    // Whole-value rather than per-match so that a redaction can be
    // structural — dropping a trailing duration line, sorting a set —
    // and not only textual.
    apply: fn(Str) -> Str

// ── private helpers ──────────────────────────────────────────────────
//
// One named function per replacement, plus the two shapes the
// replacements share: a pattern and what it replaces, and a value
// rewritten line by line.  Private because a caller gets one of these
// through a constructor that has already given it a label.

// A value rewritten line by line, with the newlines put back exactly as
// they were — including the empty last line a value ending in a newline
// splits into, which is what keeps the trailing-newline rule of the
// format true through a per-line redaction.
fn per_line(value: Str, f: fn(Str) -> Str) -> Str []
    let lines = str.split_lines(value)
    list.join([f(line) for line in lines], "\n")

// An RFC 3339 instant, and nothing looser: the `T` and the offset are
// what separate it from a calendar date a test is actually about.
fn timestamp_pattern() -> Str []
    "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})"

// A canonical UUID: eight, four, four, four and twelve lower-case hex
// digits with the hyphens.  The hyphens are why a bare hex run of the
// same length is not one.
fn uuid_pattern() -> Str []
    "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"

// A hexadecimal run of at least `min_len` characters.
fn hex_pattern(min_len: Int) -> Str []
    "[0-9a-fA-F]{" + str.from_int(min_len) + ",}"

fn redact_timestamps(value: Str) -> Str []
    regex.replace(timestamp_pattern(), placeholder(), value)

fn redact_uuids(value: Str) -> Str []
    regex.replace(uuid_pattern(), placeholder(), value)

fn redact_hex(min_len: Int, value: Str) -> Str []
    regex.replace(hex_pattern(min_len), placeholder(), value)

// A prefix is a literal, so this is a plain replacement and not a
// pattern: a checkout path with a `.` or a `+` in it is not a pattern by
// accident, and the answer for a caller who wants one is `matching`.
fn redact_prefix(prefix: Str, value: Str) -> Str []
    str.replace(value, prefix, "[root]")

// The value after a `key:` on a line whose key matches, the key kept so
// the shape of the output is still under test.
fn field_line(key: Str, line: Str) -> Str []
    if str.starts_with(line, key)
        key + " " + placeholder()
    else
        line

fn redact_field(name: Str, value: Str) -> Str []
    per_line(value, line => field_line(name + ":", line))

// One member of a JSON object, by key: the placeholder when the key is
// the one being redacted, the walk otherwise.
fn json_member_of(name: Str, key: Str, v: json.JsonValueH) -> Any []
    let inner = json.get(v, key)!
    if key == name
        json.string(placeholder())
    else
        json_walk(name, inner)

// The document rebuilt with every member named `name` replaced, at any
// depth: an object becomes an object with the same keys in the same
// order, an array an array with the same elements, and anything else
// itself.
fn json_walk(name: Str, v: json.JsonValueH) -> Any []
    let kind = json.type_of(v)
    if kind == "object"
        let pairs: [(Str, Any)] = [(k, json_member_of(name, k, v)) for k in json.keys(v)]
        json.object(pairs)
    else if kind == "array"
        let items: [Any] = [json_walk(name, e) for e in json.to_list(v) ?? []]
        json.array(items)
    else
        v

fn redact_json_member(name: Str, value: Str) -> Str []
    match json.parse(value)
        None    => value
        Some(v) => json.stringify(json_walk(name, v))

// An invalid pattern replaces nothing, and does not raise: a snapshot
// assertion is not where a person should learn their pattern is wrong.
fn redact_pattern(pattern: Str, value: Str) -> Str []
    if regex.error(pattern) == None
        regex.replace(pattern, placeholder(), value)
    else
        value

fn redact_newlines(value: Str) -> Str []
    str.replace(value, "\r\n", "\n")

fn redact_trailing_space(value: Str) -> Str []
    per_line(value, line => str.trim_end(line))

// The text a redaction leaves behind: `[redacted]`.
//
// One spelling, published, because two redactions that write different
// placeholders make a snapshot's own diff unreadable.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.placeholder())
// ```
pub fn placeholder() -> Str []
    "[redacted]"

// A redaction from a label and a named function.
//
// The constructor a caller writes their own with.
//
// ```novo
// use snapredact
// use std.str
//
// fn drop_trailing_blank(value: Str) -> Str
//     str.trim_end(value)
//
// fn main() [io]
//     println(snapredact.redaction("trailing-blank", drop_trailing_blank).label)
// ```
pub fn redaction(label: Str, apply: fn(Str) -> Str) -> SnapRedaction []
    SnapRedaction { label: label, apply: apply }

// Every redaction applied, in order.
//
// In ORDER and not as a set: a path redaction that runs after a
// timestamp one sees the text the first produced, and two orders give
// two answers.  The list the caller wrote is the order that runs.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.apply_all([], "created: 2026-09-11T10:00:00Z\n"))
// ```
pub fn apply_all(rs: [SnapRedaction], value: Str) -> Str []
    var out = value
    for r in rs
        out = r.apply(out)
    out

// The labels of a list of redactions, for the header.
//
// ```novo
// use snapredact
// use std.list
//
// fn main() [io]
//     println("${list.len(snapredact.labels([snapredact.timestamps()]))}")
// ```
pub fn labels(rs: [SnapRedaction]) -> [Str] []
    [r.label for r in rs]

// Replace anything that looks like an RFC 3339 timestamp.
//
// Label `timestamps`.  RFC 3339 and not "any date": a redaction that
// matched loosely would eat the dates a test is actually about, and a
// snapshot that redacted its own subject passes forever.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.timestamps().label)
// ```
pub fn timestamps() -> SnapRedaction []
    SnapRedaction { label: "timestamps", apply: value => redact_timestamps(value) }

// Replace anything that looks like a canonical UUID.
//
// Label `uuids`.  Eight-four-four-four-twelve lower-case hex with the
// hyphens; a bare 32-character hex run is `hex_runs`, because the two
// have different false-positive risks.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.uuids().label)
// ```
pub fn uuids() -> SnapRedaction []
    SnapRedaction { label: "uuids", apply: value => redact_uuids(value) }

// Replace hexadecimal runs of at least `min_len` characters.
//
// Label `hex`.  For hashes, content addresses and pointer values.  The
// minimum is an argument because the right one depends on what is being
// snapshotted: 40 for a git object, 16 for a pointer, and 8 would eat
// half of a hex dump.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.hex_runs(40).label)
// ```
pub fn hex_runs(min_len: Int) -> SnapRedaction []
    SnapRedaction { label: "hex", apply: value => redact_hex(min_len, value) }

// Replace a prefix wherever it appears, with `[root]`.
//
// Label `paths`.  The redaction almost every snapshot of a tool's
// output needs: a temporary directory, a checkout root, a home
// directory.  A prefix rather than a pattern, because the caller knows
// the exact string and a pattern would be a guess.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.path_prefix("/tmp/novo-a2f4k9").label)
// ```
pub fn path_prefix(prefix: Str) -> SnapRedaction []
    SnapRedaction { label: "paths", apply: value => redact_prefix(prefix, value) }

// Replace the value after a `key:` on any line whose key matches.
//
// Label `field:<name>`.  For a rendered record or a YAML-shaped
// output: `created: 2026-09-11` becomes `created: [redacted]`, and the
// key stays so the shape of the output is still under test.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.field("created").label)
// ```
pub fn field(name: Str) -> SnapRedaction []
    SnapRedaction { label: "field:" + name, apply: value => redact_field(name, value) }

// Replace the value of a JSON member with the placeholder, wherever it
// appears at any depth.
//
// Label `json:<name>`.  Parses the value as JSON and re-renders it, so
// a member inside an array inside an object is reached and the output
// is still JSON — which a line-based rule cannot promise.  A value that
// is not JSON is left exactly as it was; a redaction is not the place
// to discover that a test's output is malformed.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.json_member("id").label)
// ```
pub fn json_member(name: Str) -> SnapRedaction []
    SnapRedaction { label: "json:" + name, apply: value => redact_json_member(name, value) }

// Replace every match of a regular expression.
//
// Label `regex`.  The escape hatch, and last on purpose: the named
// redactions above say what they are about in the header, and a header
// line reading `regex` tells a reader nothing.  Reach for it when the
// volatile thing is specific to one test.
//
// An invalid pattern makes a redaction that changes nothing rather than
// one that raises, because a snapshot assertion is not where a person
// should learn their pattern is wrong — `pattern_ok` is.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.matching("run [0-9]+").label)
// ```
pub fn matching(pattern: Str) -> SnapRedaction []
    SnapRedaction { label: "regex", apply: value => redact_pattern(pattern, value) }

// Whether a pattern compiles, so a caller can be told where they wrote
// it.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     let ok = snapredact.pattern_ok("run [0-9")
//     println("${ok}")
// ```
pub fn pattern_ok(pattern: Str) -> Bool []
    regex.error(pattern) == None

// Normalise line endings to `\n` before anything else looks at the
// value.
//
// Label `newlines`.  Not applied unless a caller asks: a test of
// something that emits `\r\n` on purpose must be able to see it.  It is
// here because the alternative — a snapshot library that normalised
// silently — is how a Windows-only regression becomes invisible.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.unix_newlines().label)
// ```
pub fn unix_newlines() -> SnapRedaction []
    SnapRedaction { label: "newlines", apply: value => redact_newlines(value) }

// Drop trailing spaces from every line.
//
// Label `trailing-space`.  For output whose line padding is not the
// subject of the test, and which a person's editor will strip in the
// review anyway — so the snapshot that survives review is this one.
//
// ```novo
// use snapredact
//
// fn main() [io]
//     println(snapredact.trailing_space().label)
// ```
pub fn trailing_space() -> SnapRedaction []
    SnapRedaction { label: "trailing-space", apply: value => redact_trailing_space(value) }

// The four redactions a tool's command-line output usually needs:
// timestamps, uuids, 40-character hex runs and trailing space.
//
// A named list rather than an example in a README, because the list
// somebody copies out of a README is the list that goes stale.
//
// ```novo
// use snapredact
// use std.list
//
// fn main() [io]
//     println("${list.len(snapredact.cli_defaults())}")
// ```
pub fn cli_defaults() -> [SnapRedaction] []
    [timestamps(), uuids(), hex_runs(40), trailing_space()]
