// snapfile.nv — what is on disk, and the rule that makes it readable.
//
// THE FILE IS A HEADER AND THEN THE VALUE, VERBATIM.
//
//     --- snapshot-nv 1
//     source: tests/render_tests.nv
//     assertion: renders_a_wide_table
//     expression: tblrender.render(t, style)
//     redactions: timestamps, uuids
//     ---
//     ┌────────┬───────┐
//     │ name   │ cells │
//     └────────┴───────┘
//
// TWO DELIMITERS AND NOT ONE.  The value runs from the byte after the
// second `---` line to the end of the file, unparsed and unescaped.
// So a snapshot whose value CONTAINS `---`, or `key: value` lines, or
// a YAML document, or nothing at all, round-trips — which a
// single-delimiter format cannot promise and which matters here because
// the values people snapshot are exactly the things that look like
// other formats: rendered tables, generated YAML, patch files.
//
// A snapshot is READ BY PEOPLE, in a code review, next to the change
// that altered it.  That is the whole reason the format is text with
// the value in the clear rather than anything encoded: the diff in the
// review IS the diff of the thing under test.  Every decision here
// follows from it — no escaping, no quoting, no length prefix, and the
// trailing newline preserved exactly, because "the output grew a blank
// line" is a real regression and a format that normalised it away
// would hide it.
//
// THE HEADER IS METADATA AND NEVER PART OF THE COMPARISON.  Changing
// the expression text, or adding a redaction label, does not make a
// snapshot differ; only the value does.  `parse` and `render` are `[]`
// so the format is testable from a string, and the `[fs]` functions
// below are thin.

use snappolicy

// What a stored snapshot records about itself.
//
// Everything here is for a person reading the file in a review. None of
// it takes part in the comparison.
pub struct SnapHeader
    // The format version: `1`.  A file whose version is higher than
    // this build understands is refused by name rather than parsed
    // optimistically, because a snapshot silently misread is a test
    // that passes for the wrong reason.
    version: Int
    // The test source file this snapshot belongs to, as the caller
    // spelled it.
    source: Str
    // The assertion's name — one snapshot per name per source file.
    assertion: Str
    // The expression the value came from, as text, for the reader of
    // the file.  The caller writes it; nothing derives it, because a
    // package cannot see its caller's source.
    expression: Str
    // The labels of the redactions that were applied before the value
    // was stored, so a reader can tell a real `[timestamp]` in the
    // output from a redacted one.
    redactions: [Str]

// A stored snapshot: its header and its value.
pub struct SnapStored
    header: SnapHeader
    // Exactly the bytes after the second delimiter line, including the
    // final newline if the value has one.
    value: Str

// Everything that can go wrong with a snapshot file.
pub enum SnapError
    // There is no stored snapshot at this path.  Not always a failure:
    // what it means is the update policy's decision.
    SnapMissing(path: Str)
    SnapUnreadable(path: Str)
    SnapUnwritable(path: Str)
    // The header does not parse, at this line.  The line number is
    // one-based and counts from the start of the file, so it is the
    // line an editor jumps to.
    SnapBadHeader(path: Str, line: Int)
    // The file's format version is newer than this build.  The version
    // is carried so the message can say what would read it.
    SnapVersionAhead(path: Str, version: Int)
    // The assertion name cannot be a filename: it is empty, or it
    // carries a path separator.
    SnapBadName(name: Str)
    // A `.new` file was accepted over a snapshot that has since
    // changed underneath it.  A review tool's one real hazard, named
    // rather than resolved silently.
    SnapStale(path: Str)

// ── private helpers ──────────────────────────────────────────────────
//
// The format's own arithmetic, and nothing else: how a message names
// where it looked, the byte walk that finds the end of a header, the
// path a source file's snapshots live under, and the two directory
// walks.  They sit above their first caller because everything below
// is written in terms of them, and none of them is public because a
// caller has one way to spell each of these and it is the function
// named after it.

// How a message names the place it looked: the path in backticks, or
// the text itself when the caller had no path to give `parse`.
fn place(path: Str) -> Str []
    if str.is_empty(path)
        "this text"
    else
        "`${path}`"

// The sentence for a name that cannot become a filename.
fn name_refusal(name: Str) -> Str []
    if str.is_empty(name)
        "an assertion name cannot be empty"
    else
        "`${name}` cannot be an assertion name: it carries a path separator"

// The format version a magic line declares, or `None` when the line is
// not a magic line at all.
fn version_of(line: Str) -> ?Int []
    let prefix = "--- snapshot-nv "
    if str.starts_with(line, prefix)
        str.to_int(str.slice(line, str.len(prefix), str.len(line)))
    else
        None

// The text after a key, which the caller has already matched as a
// prefix of the line — so the offset is the key's own length and not a
// number written twice.
fn after_key(line: Str, key: Str) -> Str []
    str.slice(line, str.len(key), str.len(line))

// The redaction labels a header line carries: `a, b` is two labels,
// and an empty field is none.
fn split_labels(raw: Str) -> [Str] []
    if str.is_empty(raw)
        []
    else
        str.split(raw, ", ")

// The value's bytes: everything from the delimiter's end to the end of
// the file.  `at` past the end answers the empty value rather than a
// slice with its ends the wrong way round, which is what a file that
// stops at the delimiter line itself produces.
fn value_tail(text: Str, at: Int) -> Str []
    if at >= str.len(text)
        ""
    else
        str.slice(text, at, str.len(text))

// The name a snapshot file carries for one assertion: the source file's
// stem, insta's double underscore, the assertion, the suffix.
fn stem_prefix(source: Str) -> Str []
    path.stem(source) + "__"

// The assertion name inside `<stem>__<assertion><suffix>`.
fn name_between(name: Str, prefix: Str, suffix: Str) -> Str []
    str.slice(name, str.len(prefix), str.len(name) - str.len(suffix))

// The directory a source file's snapshots live in, relative to the
// source file's own directory.
fn stored_dir(c: snappolicy.SnapConfig, source: Str) -> Str []
    path.join(path.dirname(source), c.dir)

// Every `.new` file under a directory, recursively, as paths, sorted so
// two machines present the same changes in the same order.
fn walk_rejected(c: snappolicy.SnapConfig, dir: Str) -> [Str] [fs]
    var found: [Str] = []
    for entry in fs.read_dir(dir)
        let child = path.join(dir, entry)
        if fs.is_dir(child)
            let deeper = walk_rejected(c, child)
            found = list.append(found, deeper)
        elif str.ends_with(entry, c.new_suffix)
            found = list.push(found, child)
    found = list.sort(found)
    found

// The assertion names a directory holds for one source file's stem: the
// entries carrying the prefix and the stored suffix, with both of them
// taken off again.
fn names_under(dir: Str, prefix: Str, suffix: Str) -> [Str] [fs]
    var names: [Str] = []
    for entry in fs.read_dir(dir)
        if str.starts_with(entry, prefix) and str.ends_with(entry, suffix)
            names = list.push(names, name_between(entry, prefix, suffix))
    names = list.sort(names)
    names

// Whether the stored snapshot was written after the rejected one, which
// is the hazard a review that runs after a rebase meets.  No stored
// file at all is never stale: there is nothing for the `.new` to
// overwrite.
fn is_stale(path: Str, rejected: Str) -> Bool [fs]
    if not fs.exists(path)
        false
    else
        let stored_at = fs.file_mtime(path) ?? 0
        let rejected_at = fs.file_mtime(rejected) ?? 0
        stored_at > rejected_at

// The directory part of a path.  One place, with a parameter that is
// not itself named `path`, because the interface's own spelling of that
// parameter shadows the stdlib module inside these functions and a
// `path.dirname(...)` call would then be a name that no longer reaches
// the module (W0002).
fn dir_of(p: Str) -> Str []
    path.dirname(p)

// The snapshot at a path is not there, for a reason `read` gives the
// caller: absence is the answer the update policy acts on, and an
// existing file that cannot be read is a different answer.
fn unreadable(path: Str) -> Result<SnapStored, SnapError> [fs]
    if fs.exists(path)
        Err(SnapUnreadable(path))
    else
        Err(SnapMissing(path))

// The header walk: the four fields, and the byte the value starts at.
// The offset counts the magic line the caller has already checked, then
// every line it consumes, each with its newline — so it is exact for a
// file whose value is empty, one that ends without a newline, and one
// whose value is a YAML document full of `---` lines alike.
fn parse_fields(path: Str, text: Str, lines: [Str]) -> Result<SnapStored, SnapError> []
    var source = ""
    var assertion = ""
    var expression = ""
    var redactions: [Str] = []
    var value_start: ?Int = None
    var at = str.len(list.get(lines, 0, "")) + 1
    var i = 1
    while i < list.len(lines)
        let line = list.get(lines, i)
        at = at + str.len(line) + 1
        match line
            "---"                                      =>
                value_start = Some(at)
                break
            _ if str.starts_with(line, "source: ")     =>
                source = after_key(line, "source: ")
            _ if str.starts_with(line, "assertion: ")  =>
                assertion = after_key(line, "assertion: ")
            _ if str.starts_with(line, "expression: ") =>
                expression = after_key(line, "expression: ")
            _ if str.starts_with(line, "redactions: ") =>
                redactions = split_labels(after_key(line, "redactions: "))
            _                                          =>
                return Err(SnapBadHeader(path, i + 1))
        i = i + 1
    let value_at = match value_start
        Some(found) => found
        None        =>
            return Err(SnapBadHeader(path, i))
    Ok(SnapStored {
        header: SnapHeader {
            version: format_version(),
            source: source,
            assertion: assertion,
            expression: expression,
            redactions: redactions },
        value: value_tail(text, value_at) })

// The version half of the walk: this build reads version 1, a newer file
// is refused by name, and anything below 1 is not a format version.
fn version_refusal(path: Str, v: Int) -> Result<SnapStored, SnapError> []
    if v > format_version()
        Err(SnapVersionAhead(path, v))
    else
        Err(SnapBadHeader(path, 1))

// `parse`, with the caller's path attached to whatever refusal comes
// out, so every message a file read produces names the file.
fn parse_at(path: Str, text: Str) -> Result<SnapStored, SnapError> []
    let lines = str.split_lines(text)
    match version_of(list.get(lines, 0, ""))
        None    => Err(SnapBadHeader(path, 1))
        Some(v) => if v == format_version()
            parse_fields(path, text, lines)
        else
            version_refusal(path, v)

// The sentence a `Result<_, SnapError>` carries.
//
// SPEC § 3.4 admits a type as a `Result`'s error type only when it
// implements `Error`, so this impl is what lets the functions here
// answer their own refusal instead of a `Result<_, Str>` that has
// thrown the variant away.
//
// Every message names the path, and `SnapBadHeader`'s names the line,
// because the reader's next action is to open the file there.
//
// ```novo
// use snapfile
//
// fn main() [io, fs]
//     match snapfile.read("tests/snapshots/nothing.snap")
//         Ok(_)  => println("read")
//         Err(e) => println(e.message())
// ```
impl Error for SnapError
    fn message(self) -> Str
        match self
            SnapMissing(path)         => "no snapshot at ${place(path)}"
            SnapUnreadable(path)      => "could not read the snapshot at ${place(path)}"
            SnapUnwritable(path)      => "could not write the snapshot at ${place(path)}"
            SnapBadHeader(path, line) => "not a snapshot header at line ${line} of ${place(path)}"
            SnapVersionAhead(path, v) => "${place(path)} is format version ${v}, and this build reads ${format_version()}"
            SnapBadName(name)         => name_refusal(name)
            SnapStale(path)           => "the snapshot at ${place(path)} changed after the rejected one was written"

// The format version this build writes: `1`.
//
// ```novo
// use snapfile
//
// fn main() [io]
//     println("${snapfile.format_version()}")
// ```
pub fn format_version() -> Int []
    1

// A header for a snapshot, with no expression and no redactions.
//
// ```novo
// use snapfile
//
// fn main() [io]
//     println(snapfile.header("tests/render_tests.nv", "a_wide_table").assertion)
// ```
pub fn header(source: Str, assertion: Str) -> SnapHeader []
    SnapHeader {
        version: format_version(),
        source: source,
        assertion: assertion,
        expression: "",
        redactions: [] }

// The header with the expression text a reader sees.
//
// ```novo
// use snapfile
//
// fn main() [io]
//     let h = snapfile.header("tests/render_tests.nv", "a_wide_table")
//     println(snapfile.with_expression(h, "render(t)").expression)
// ```
pub fn with_expression(h: SnapHeader, expression: Str) -> SnapHeader []
    SnapHeader {
        version: h.version,
        source: h.source,
        assertion: h.assertion,
        expression: expression,
        redactions: h.redactions }

// The header with the redaction labels recorded.
//
// ```novo
// use snapfile
// use std.list
//
// fn main() [io]
//     let h = snapfile.header("tests/render_tests.nv", "a_wide_table")
//     println("${list.len(snapfile.with_redactions(h, ["timestamps"]).redactions)}")
// ```
pub fn with_redactions(h: SnapHeader, labels: [Str]) -> SnapHeader []
    SnapHeader {
        version: h.version,
        source: h.source,
        assertion: h.assertion,
        expression: h.expression,
        redactions: labels }

// The whole file as text: the header, the delimiter, the value.
//
// ```novo
// use snapfile
//
// fn main() [io]
//     let s = SnapStored { header: snapfile.header("t.nv", "a"), value: "hello\n" }
//     println(snapfile.render(s))
// ```
pub fn render(s: SnapStored) -> Str []
    let h = s.header
    let labels = "redactions: " + list.join(h.redactions, ", ")
    let text = str.join([
        "--- snapshot-nv ${h.version}",
        "source: ${h.source}",
        "assertion: ${h.assertion}",
        "expression: ${h.expression}",
        labels,
        "---"],
        "\n")
    text + "\n" + s.value

// The same bytes, appended to a caller's buffer.
//
// For a runner writing many snapshots without a `Str` per file.
//
// ```novo
// use snapfile
// use std.list
//
// fn main() [io]
//     let s = SnapStored { header: snapfile.header("t.nv", "a"), value: "hello\n" }
//     println("${list.len(snapfile.render_into([], s))}")
// ```
pub fn render_into(out: [u8], s: SnapStored) -> [u8] []
    let text = render(s)
    let more = bytes.to_byte_list(bytes.from_str(text))
    list.concat(out, more)

// The inverse of `render`, from the file's text.
//
// `[]`, and the reason the format is testable without a filesystem:
// every round-trip case in this package's suite is a string in and a
// string out.
//
// ```novo
// use snapfile
//
// fn main() [io]
//     match snapfile.parse("not a snapshot")
//         Ok(_)  => println("parsed")
//         Err(e) => println(e.message())
// ```
pub fn parse(text: Str) -> Result<SnapStored, SnapError> []
    parse_at("", text)

// Where the snapshot for this assertion lives.
//
// `<directory of source>/<config.dir>/<stem of source>__<assertion><config.suffix>`
// — the double underscore is insta's, and it is what lets one glob
// find every snapshot belonging to one test file.
//
// `SnapBadName` when the assertion name carries a path separator or is
// empty: an assertion name becomes a filename, so it is the one piece
// of caller text that has to be checked.
//
// ```novo
// use snappolicy
// use snapfile
//
// fn main() [io]
//     match snapfile.snapshot_path(snappolicy.config(), "tests/render_tests.nv", "a_wide_table")
//         Ok(p)  => println(p)
//         Err(e) => println(e.message())
// ```
pub fn snapshot_path(c: snappolicy.SnapConfig, source: Str,
                     assertion: Str) -> Result<Str, SnapError> []
    if not name_ok(assertion)
        Err(SnapBadName(assertion))
    else
        Ok(path.join(stored_dir(c, source),
                     stem_prefix(source) + assertion + c.suffix))

// The `.new` path beside a snapshot path.
//
// ```novo
// use snappolicy
// use snapfile
//
// fn main() [io]
//     println(snapfile.new_path(snappolicy.config(), "tests/snapshots/t__a.snap"))
// ```
pub fn new_path(c: snappolicy.SnapConfig, path: Str) -> Str []
    if str.ends_with(path, c.suffix)
        str.slice(path, 0, str.len(path) - str.len(c.suffix)) + c.new_suffix
    else
        path + c.new_suffix

// Whether a path is a rejected snapshot rather than a stored one.
//
// The predicate a repository's ignore rules and a review tool both
// need, and the reason `new_suffix` is a field rather than a derived
// string.
//
// ```novo
// use snappolicy
// use snapfile
//
// fn main() [io]
//     let rejected = snapfile.is_rejected(snappolicy.config(), "tests/snapshots/t__a.snap.new")
//     println("${rejected}")
// ```
pub fn is_rejected(c: snappolicy.SnapConfig, path: Str) -> Bool []
    str.ends_with(path, c.new_suffix)

// Read and parse the snapshot at a path.
//
// `SnapMissing` when there is no file, which is a different answer from
// `SnapUnreadable` because the update policy acts on the first and
// never on the second.
//
// ```novo
// use snapfile
//
// fn main() [io, fs]
//     match snapfile.read("tests/snapshots/t__a.snap")
//         Ok(s)  => println(s.header.assertion)
//         Err(e) => println(e.message())
// ```
pub fn read(path: Str) -> Result<SnapStored, SnapError> [fs]
    match fs.read(path)
        Some(text) => parse_at(path, text)
        None       => unreadable(path)

// Write a snapshot to a path, creating the directory if it is absent.
//
// ```novo
// use snapfile
//
// fn main() [io, fs]
//     let s = SnapStored { header: snapfile.header("t.nv", "a"), value: "hello\n" }
//     match snapfile.write("tests/snapshots/t__a.snap", s)
//         Some(e) => println(e.message())
//         None    => println("written")
// ```
pub fn write(path: Str, s: SnapStored) -> ?SnapError [fs]
    let _ = fs.mkdir_all(dir_of(path))
    if fs.write(path, render(s))
        None
    else
        Some(SnapUnwritable(path))

// Write the rejected value beside the stored snapshot, and answer where
// it landed.
//
// ```novo
// use snappolicy
// use snapfile
//
// fn main() [io, fs]
//     let s = SnapStored { header: snapfile.header("t.nv", "a"), value: "hello\n" }
//     match snapfile.write_rejected(snappolicy.config(), "tests/snapshots/t__a.snap", s)
//         Ok(p)  => println(p)
//         Err(e) => println(e.message())
// ```
pub fn write_rejected(c: snappolicy.SnapConfig, path: Str,
                      s: SnapStored) -> Result<Str, SnapError> [fs]
    let rejected = new_path(c, path)
    match write(rejected, s)
        Some(e) => Err(e)
        None    => Ok(rejected)

// Remove the `.new` file beside a snapshot, if there is one.
//
// What a run that now matches has to do, and the step every hand-rolled
// snapshot helper forgets: a stale `.new` beside a passing snapshot
// makes a review tool offer a change nobody made.
//
// ```novo
// use snappolicy
// use snapfile
//
// fn main() [io, fs]
//     match snapfile.clear_rejected(snappolicy.config(), "tests/snapshots/t__a.snap")
//         Some(e) => println(e.message())
//         None    => println("cleared")
// ```
pub fn clear_rejected(c: snappolicy.SnapConfig, path: Str) -> ?SnapError [fs]
    let rejected = new_path(c, path)
    if not fs.exists(rejected)
        None
    elif fs.delete(rejected)
        None
    else
        Some(SnapUnwritable(rejected))

// Every rejected snapshot under a directory, in sorted order.
//
// The list a review flow works through.  Sorted, so two runs on two
// machines present the same changes in the same order.
//
// ```novo
// use snappolicy
// use snapfile
// use std.list
//
// fn main() [io, fs]
//     println("${list.len(snapfile.rejected_under(snappolicy.config(), "tests"))}")
// ```
pub fn rejected_under(c: snappolicy.SnapConfig, dir: Str) -> [Str] [fs]
    walk_rejected(c, dir)

// Accept a rejected snapshot: move the `.new` file over the stored one.
//
// `SnapStale` when the stored snapshot changed after the `.new` was
// written — the one real hazard of a review that runs after a rebase,
// and the reason this is a function here rather than two lines in a
// shell script.
//
// ```novo
// use snappolicy
// use snapfile
//
// fn main() [io, fs]
//     match snapfile.accept_rejected(snappolicy.config(), "tests/snapshots/t__a.snap")
//         Some(e) => println(e.message())
//         None    => println("accepted")
// ```
pub fn accept_rejected(c: snappolicy.SnapConfig, path: Str) -> ?SnapError [fs]
    let rejected = new_path(c, path)
    if not fs.exists(rejected)
        Some(SnapMissing(rejected))
    elif is_stale(path, rejected)
        Some(SnapStale(path))
    elif fs.rename(rejected, path)
        None
    else
        Some(SnapUnwritable(path))

// Every stored snapshot under a directory that belongs to this source
// file.
//
// The other half of the unused-snapshot check: a runner collects the
// names its tests asked for and compares them with this.
//
// ```novo
// use snappolicy
// use snapfile
// use std.list
//
// fn main() [io, fs]
//     let c = snappolicy.config()
//     println("${list.len(snapfile.stored_for(c, "tests/render_tests.nv"))}")
// ```
pub fn stored_for(c: snappolicy.SnapConfig, source: Str) -> [Str] [fs]
    names_under(stored_dir(c, source), stem_prefix(source), c.suffix)

// The stored names a run did not ask for.
//
// `[]`, because it is set arithmetic over two lists the caller already
// has — which is what makes the unused check a runner's decision rather
// than an assertion's.
//
// ```novo
// use snapfile
// use std.list
//
// fn main() [io]
//     println("${list.len(snapfile.unused_names(["a", "b"], ["a"]))}")
// ```
pub fn unused_names(stored: [Str], used: [Str]) -> [Str] []
    list.filter(stored, name => not list.contains(used, name))

// The value a stored snapshot holds.
//
// ```novo
// use snapfile
//
// fn main() [io]
//     let s = SnapStored { header: snapfile.header("t.nv", "a"), value: "hello\n" }
//     println(snapfile.value_of(s))
// ```
pub fn value_of(s: SnapStored) -> Str []
    s.value

// Whether an assertion name can become a filename.
//
// False for the empty name and for anything carrying a path separator.
// Published so a runner can refuse a bad name where it is written
// rather than at the first snapshot.
//
// ```novo
// use snapfile
//
// fn main() [io]
//     let ok = snapfile.name_ok("renders/a/table")
//     println("${ok}")
// ```
pub fn name_ok(assertion: Str) -> Bool []
    not str.is_empty(assertion) and not str.contains(assertion, "/")
